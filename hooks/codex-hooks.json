{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${PLUGIN_ROOT}/scripts/roblox-optimum.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${PLUGIN_ROOT}/scripts/roblox-optimum.mjs", "--compact"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
