{
  "name": "roblox-optimum",
  "version": "1.7.0",
  "description": "Deterministic Roblox and Luau standards checks: deprecated APIs and out-of-order section headers, as an agent hook, a commit hook, or a CI step.",
  "keywords": [
    "roblox",
    "luau",
    "lint",
    "linter",
    "static-analysis",
    "pre-commit",
    "game-development",
    "ai-agent"
  ],
  "type": "module",
  "bin": {
    "roblox-optimum": "scripts/roblox-optimum.mjs",
    "roblox-mcp": "scripts/roblox-mcp.mjs",
    "roblox-studio-mcp-antigravity": "scripts/studio-mcp-antigravity.mjs"
  },
  "files": [
    "scripts/roblox-optimum.mjs",
    "scripts/roblox-mcp.mjs",
    "skills/",
    "agents/",
    "rules/",
    "AGENTS.md",
    "plugin.json",
    ".cursor-plugin/",
    "mcp.json",
    "mcp_config.json",
    "scripts/studio-mcp-antigravity.mjs"
  ],
  "scripts": {
    "test": "node scripts/check-versions.mjs && node scripts/audit.mjs && node scripts/roblox-optimum.mjs --selftest && node scripts/roblox-mcp.mjs --selftest && node scripts/studio-mcp-antigravity.mjs --selftest"
  },
  "author": {
    "name": "andrian-syh",
    "url": "https://github.com/andrian-syh"
  },
  "license": "MIT",
  "homepage": "https://github.com/andrian-syh/roblox-optimum",
  "bugs": "https://github.com/andrian-syh/roblox-optimum/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrian-syh/roblox-optimum.git"
  },
  "engines": {
    "node": ">=18"
  }
}
