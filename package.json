{
  "name": "roblox-optimum",
  "version": "1.14.0",
  "description": "Roblox and Luau standards for AI agents, paired with a deterministic static checker.",
  "keywords": [
    "roblox",
    "luau",
    "lint",
    "linter",
    "static-analysis",
    "pre-commit",
    "game-development",
    "ai-agent"
  ],
  "type": "module",
  "bin": {
    "roblox-optimum": "scripts/roblox-optimum.mjs",
    "roblox-mcp": "scripts/roblox-mcp.mjs",
    "roblox-studio-mcp-antigravity": "scripts/studio-mcp-antigravity.mjs"
  },
  "files": [
    "scripts/roblox-optimum.mjs",
    "scripts/roblox-mcp.mjs",
    "scripts/lib/",
    "skills/",
    "agents/",
    "rules/",
    "assets/",
    "AGENTS.md",
    "plugin.json",
    "hooks.json",
    ".cursor-plugin/",
    "mcp.json",
    "mcp_config.json",
    "!skills/*/evals",
    "scripts/studio-mcp-antigravity.mjs"
  ],
  "scripts": {
    "test": "node scripts/check-versions.mjs && node scripts/audit.mjs && node --test \"test/*.test.mjs\""
  },
  "author": {
    "name": "andrian-syh",
    "url": "https://github.com/andrian-syh"
  },
  "license": "MIT",
  "homepage": "https://github.com/andrian-syh/roblox-optimum",
  "bugs": "https://github.com/andrian-syh/roblox-optimum/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrian-syh/roblox-optimum.git"
  },
  "engines": {
    "node": ">=22"
  }
}
